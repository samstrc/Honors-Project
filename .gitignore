# Raw data (2.5 GB of Kaggle CSVs) and everything derived from it that can be rebuilt.
# Anchored to the root: an unanchored 'Data/' also matched web-app/frontend/public/data/
# (git ignores case on macOS), which hid the site's findings JSON from the repo.
/Data/
Modeling/utilities/cache/
Modeling/ARCHIVED/
Modeling/models/superseded/

# Paperwork and drafts stay local
Documents/
Chatbot/docs/

# Secrets: OPENAI_API_KEY etc. live in Modeling/.env and are never committed
.env
.env.*
!.env.example

# Generated
node_modules/
dist/
build/
__pycache__/
*.pyc
deploy/hf-space/
*.log
.DS_Store
.streamlit/secrets.toml

