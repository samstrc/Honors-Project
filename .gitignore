# Raw data (2.5 GB of Kaggle CSVs) and everything derived from it that can be rebuilt.
# Anchored to the root so it can't also match frontend/public/data/.
/data/
modeling/cache/
modeling/models/superseded/

# documents/rag/ (what the guide indexes) and documents/other/ (personal paperwork)
# stay local
/documents/
# The paper stays local until it's submitted. Nothing the site runs on reads it; the
# guide's index is built from paper/main.pdf on this machine.
/paper/

# Secrets: OPENAI_API_KEY lives in backend/.env and is never committed
.env
.env.*
!.env.example

# Generated
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
*.log
.DS_Store

# Personal
.Rhistory

# Local working files: assistant instructions and helper scripts
/CLAUDE.md
/claude_scripts/
