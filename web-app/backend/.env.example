# Copy this file to .env. .env is gitignored.
#
# This server is a pure proxy -- it holds no API keys of its own. OPENAI_API_KEY lives
# only in Modeling/.env or Chatbot/.env (same place the original Chatbot/ package already
# reads it from), because the real chat logic runs in guide-service/, not here.

# Where the FastAPI model service (Modeling/api/main.py) is running. This server proxies
# POST /api/predict to it so the browser never talks to it directly.
PREAPPROVAL_API_URL=http://localhost:8000

# Where the research-guide service (../guide-service/main.py, a thin wrapper around
# Chatbot/chat.py's Guide class) is running. This server proxies POST /api/chat to it.
GUIDE_API_URL=http://localhost:8001

# Port this Express server listens on. The Vite dev server proxies /api here.
PORT=8787
